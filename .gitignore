/.phpunit.cache/
/.porta/
/coverage/
/vendor/
# A plugin may vendor its own composer dependencies; they are the plugin's to
# install, not ours to commit, lint or cover.
plugins/*/vendor/
.porta.json
# Project Architecture writes here now that its output directory defaults to
# the project root, and Graph: Export SVG/PNG lands beside it.
/architecture.dot
/architecture.svg
/architecture.png

# Written only when a test leaks a global-scope settings write into the shared
# fixture home (tests pin their scope to Project to prevent it). Ignored so a
# leak can never be committed; tests/bootstrap.php deletes it on every run.
/tests/Support/fixtures/home/.porta/config.json

# Written by every booted Ide: PORTA_HOME points here for the suite, and the
# IDE records its project root for the switcher's list. The entries are dead
# temp paths the moment the run ends.
/tests/Support/fixtures/home/.porta/recent-projects.json

# Claude's per-round checklist (CLAUDE.md, Working style).
/TASKS.md

# The phar and the Box binary that builds it (composer build:phar).
/build/
