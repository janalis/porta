{
    "name": "janalis/porta",
    "description": "A terminal IDE for PHP projects, built on symfony/tui with LSP support, syntax highlighting and autocompletion",
    "type": "library",
    "license": "MIT",
    "keywords": ["tui", "ide", "editor", "lsp", "terminal"],
    "autoload": {
        "psr-4": {
            "Porta\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Porta\\Tests\\": "tests/"
        }
    },
    "bin": ["bin/porta"],
    "require": {
        "php": ">=8.4",
        "ext-gd": "*",
        "ext-mbstring": "*",
        "ext-pcntl": "*",
        "ext-simplexml": "*",
        "revolt/event-loop": "^1.0",
        "symfony/clock": "^8.1",
        "symfony/config": "^8.1",
        "symfony/console": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/event-dispatcher": "^8.1",
        "symfony/filesystem": "^8.1",
        "symfony/finder": "^8.1",
        "symfony/process": "^8.1",
        "symfony/translation": "^8.1",
        "symfony/tui": "^8.1",
        "tempest/highlight": "^2.16"
    },
    "require-dev": {
        "brianium/paratest": "^7.23",
        "carthage-software/mago": "1.43.*",
        "phpunit/phpunit": "^13.2"
    },
    "scripts": {
        "dev": "@php bin/porta",
        "format": "mago format",
        "format:check": "mago format --check",
        "lint": "mago lint",
        "analyze": "mago analyze",
        "test": "@php vendor/bin/paratest --processes=auto --functional",
        "test:serial": "@php vendor/bin/phpunit",
        "coverage": "@php -d pcov.enabled=1 vendor/bin/paratest --processes=auto --functional --passthru-php='-d pcov.enabled=1' --coverage-clover coverage/clover.xml",
        "coverage:check": [
            "@coverage",
            "@php tools/coverage-check.php coverage/clover.xml 100"
        ],
        "arch": "@php tools/architecture-check.php",
        "container": "@php tools/container-debug.php"
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    }
}
