{
    "name": "janalis/porta",
    "description": "A terminal IDE for PHP projects, built on symfony/tui with LSP support, syntax highlighting and autocompletion",
    "type": "library",
    "license": "MIT",
    "keywords": ["tui", "ide", "editor", "lsp", "terminal"],
    "autoload": {
        "psr-4": {
            "Porta\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Porta\\Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "tests/Support/fixtures/"
        ]
    },
    "bin": ["bin/porta"],
    "require": {
        "php": ">=8.4 <9",
        "ext-ctype": "*",
        "ext-mbstring": "*",
        "ext-pcntl": "*",
        "revolt/event-loop": "^1.0",
        "symfony/clock": "^8.1",
        "symfony/config": "^8.1",
        "symfony/console": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/event-dispatcher": "^8.1",
        "symfony/filesystem": "^8.1",
        "symfony/finder": "^8.1",
        "symfony/polyfill-intl-grapheme": "^1.33",
        "symfony/process": "^8.1",
        "symfony/translation": "^8.1",
        "symfony/tui": "^8.1",
        "tempest/highlight": "^2.16"
    },
    "require-dev": {
        "brianium/paratest": "^7.23",
        "carthage-software/mago": "1.45.*",
        "ext-simplexml": "*",
        "phpunit/phpunit": "^13.2"
    },
    "suggest": {
        "ext-gd": "Lets the bundled image-viewer (and graph-viewer) plugins decode images"
    },
    "scripts": {
        "dev": "@php bin/porta",
        "format": "mago format",
        "format:check": "mago format --check",
        "lint": "mago lint",
        "analyze": "mago analyze",
        "test": "@php vendor/bin/paratest --processes=auto --functional",
        "test:serial": "@php vendor/bin/phpunit",
        "coverage": "@php -d pcov.enabled=1 -d pcov.directory=. -d pcov.exclude='#/(vendor|tests)/#' vendor/bin/paratest --processes=auto --functional --passthru-php=\"'-d' 'pcov.enabled=1' '-d' 'pcov.directory=.' '-d' 'pcov.exclude=#/(vendor|tests)/#'\" --coverage-clover coverage/clover.xml",
        "coverage:plugins": "@php -d pcov.enabled=1 -d pcov.directory=. -d pcov.exclude='#/(vendor|tests)/#' vendor/bin/phpunit --testsuite Plugins --coverage-filter plugins --coverage-clover coverage/plugins-clover.xml",
        "coverage:check": [
            "@coverage",
            "@php bin/porta-dev coverage:check coverage/clover.xml 100",
            "@coverage:plugins",
            "@php bin/porta-dev coverage:check coverage/plugins-clover.xml 100 --only=/plugins/ --require=plugins"
        ],
        "arch": "@php bin/porta-dev arch",
        "container": "@php bin/porta-dev container"
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.4.1"
        }
    }
}
