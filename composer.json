{
    "name": "janalis/porta",
    "description": "A terminal IDE for PHP projects, built on symfony/tui with LSP support, syntax highlighting and autocompletion",
    "type": "library",
    "license": "MIT",
    "keywords": ["tui", "ide", "editor", "lsp", "terminal"],
    "autoload": {
        "psr-4": {
            "Porta\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Porta\\Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "tests/Support/fixtures/"
        ]
    },
    "bin": ["bin/porta"],
    "require": {
        "php": ">=8.4 <9",
        "ext-ctype": "*",
        "ext-mbstring": "*",
        "ext-pcntl": "*",
        "composer/semver": "^3.4",
        "revolt/event-loop": "^1.0",
        "symfony/clock": "^8.1",
        "symfony/config": "^8.1",
        "symfony/console": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/event-dispatcher": "^8.1",
        "symfony/filesystem": "^8.1",
        "symfony/finder": "^8.1",
        "symfony/polyfill-intl-grapheme": "^1.33",
        "symfony/process": "^8.1",
        "symfony/translation": "^8.1",
        "symfony/tui": "^8.1",
        "tempest/highlight": "^2.16"
    },
    "require-dev": {
        "ext-simplexml": "*",
        "brianium/paratest": "^7.23",
        "carthage-software/mago": "1.46.*",
        "infection/infection": "^0.34.2",
        "phpunit/phpunit": "^13.2",
        "systemsdk/phpcpd": "^9.1"
    },
    "suggest": {
        "ext-gd": "Lets the bundled image-viewer (and graph-viewer) plugins decode images"
    },
    "scripts": {
        "dev": "@php bin/porta",
        "format": "mago format",
        "format:check": "mago format --check",
        "lint": "mago lint --minimum-fail-level=note",
        "analyze": "mago analyze --minimum-fail-level=note",
        "test": "@php vendor/bin/paratest --processes=${PORTA_TEST_PROCESSES:-$(( ($(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4) + 1) / 2 ))} --functional",
        "test:serial": "@php vendor/bin/phpunit --order-by=default",
        "coverage": "@php -d pcov.enabled=1 -d pcov.directory=. -d pcov.exclude='#/(vendor|tests)/#' vendor/bin/paratest --processes=${PORTA_TEST_PROCESSES:-$(( ($(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4) + 1) / 2 ))} --functional --passthru-php=\"'-d' 'pcov.enabled=1' '-d' 'pcov.directory=.' '-d' 'pcov.exclude=#/(vendor|tests)/#'\" --coverage-clover coverage/clover.xml",
        "coverage:plugins": [
            "@php bin/porta-dev coverage:plugins --processes=${PORTA_SHARD_PROCESSES:-$(( ($(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4) + 1) / 2 ))}",
            "@php bin/porta-dev coverage:check coverage/plugins 100 --only=/plugins/ --require=plugins"
        ],
        "coverage:src": [
            "@coverage",
            "@php bin/porta-dev coverage:check coverage/clover.xml 100"
        ],
        "coverage:check": [
            "@coverage:src",
            "@coverage:plugins"
        ],
        "arch": "@php bin/porta-dev arch",
        "flake:scan": "@php bin/porta-dev flake:scan",
        "duplication": "@php vendor/bin/phpcpd --exclude vendor src plugins tests bin config",
        "container": "@php bin/porta-dev container",
        "verify:quick": [
            "@format:check",
            "@lint",
            "@analyze",
            "@arch",
            "@duplication"
        ],
        "verify": [
            "@verify:quick",
            "@coverage:check"
        ],
        "mutate": [
            "@php -d pcov.enabled=1 vendor/bin/phpunit --testsuite=Unit --order-by=default --coverage-xml=coverage/infection/coverage-xml --log-junit=coverage/infection/junit.xml",
            "@php vendor/bin/infection --coverage=coverage/infection --skip-initial-tests --git-diff-lines --git-diff-base=HEAD --threads=${PORTA_MUTATE_THREADS:-$(( ($(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4) + 1) / 2 ))} --test-framework-options='--testsuite=Unit --colors=never' --show-mutations"
        ]
    },
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        },
        "process-timeout": 0,
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.4.1"
        }
    }
}
