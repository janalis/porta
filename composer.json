{
    "name": "janalis/porta",
    "description": "A terminal IDE for PHP projects, built on symfony/tui with LSP support, syntax highlighting and autocompletion",
    "type": "library",
    "license": "MIT",
    "keywords": ["tui", "ide", "editor", "lsp", "terminal"],
    "autoload": {
        "psr-4": {
            "Porta\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Porta\\Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "tests/Support/fixtures/"
        ]
    },
    "bin": ["bin/porta"],
    "require": {
        "php": ">=8.5 <9",
        "ext-ctype": "*",
        "ext-mbstring": "*",
        "ext-pcntl": "*",
        "composer/semver": "^3.4",
        "revolt/event-loop": "^1.0",
        "symfony/clock": "^8.2",
        "symfony/config": "^8.2",
        "symfony/console": "^8.2",
        "symfony/dependency-injection": "^8.2",
        "symfony/event-dispatcher": "^8.2",
        "symfony/filesystem": "^8.2",
        "symfony/finder": "^8.2",
        "symfony/polyfill-intl-grapheme": "^1.33",
        "symfony/process": "^8.2",
        "symfony/translation": "^8.2",
        "symfony/tui": "^8.2",
        "tempest/highlight": "^2.16"
    },
    "require-dev": {
        "ext-simplexml": "*",
        "brianium/paratest": "^7.23",
        "carthage-software/mago": "1.47.*",
        "infection/infection": "^0.35.4",
        "phpunit/php-invoker": "^7.0",
        "phpunit/phpunit": "^13.2",
        "rector/rector": "^2.6",
        "systemsdk/phpcpd": "^9.1"
    },
    "suggest": {
        "ext-gd": "Lets the bundled image-viewer (and graph-viewer) plugins decode images"
    },
    "scripts": {
        "dev": "@php bin/porta",
        "format": "mago format",
        "format:check": "mago format --check",
        "lint": "mago lint --minimum-fail-level=note",
        "analyze": "mago analyze --minimum-fail-level=note",
        "rector": "rector process",
        "rector:check": "rector process --dry-run --no-progress-bar",
        "fix": [
            "rector process --no-progress-bar",
            "mago format"
        ],
        "check": "@php bin/keep-going verify:quick",
        "test": "@php vendor/bin/paratest --processes=${PORTA_TEST_PROCESSES:-$(( ($(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4) + 1) / 2 ))} --functional --enforce-time-limit --default-time-limit=10",
        "test:unit": "@test --testsuite=Unit",
        "test:e2e": "@test --testsuite=E2e",
        "test:plugins": "@test --testsuite=Plugins",
        "test:integration": "@test --testsuite=Integration",
        "test:serial": "@php vendor/bin/phpunit --order-by=default",
        "coverage": "@php -d pcov.enabled=1 -d pcov.directory=src vendor/bin/paratest --processes=${PORTA_TEST_PROCESSES:-$(( ($(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4) + 1) / 2 ))} --functional --passthru-php=\"'-d' 'pcov.enabled=1' '-d' 'pcov.directory=src'\" --coverage-clover coverage/clover.xml",
        "coverage:plugins": [
            "@php bin/porta-dev coverage:plugins --processes=${PORTA_SHARD_PROCESSES:-$(( $(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4) * 3 / 4 ))}",
            "@php bin/porta-dev coverage:check coverage/plugins 100 --only=/plugins/ --require=plugins"
        ],
        "coverage:src": [
            "@putenv PORTA_CONTAINER_CACHE=on",
            "@putenv PORTA_COVERAGE_SWEEP=1",
            "@coverage --testsuite=Unit,Integration,E2e",
            "@php bin/porta-dev coverage:check coverage/clover.xml 100 --require=src"
        ],
        "coverage:check": "@php bin/keep-going coverage:parts --concurrent",
        "coverage:parts": [
            "@coverage:src",
            "@coverage:plugins"
        ],
        "arch": "@php bin/porta-dev arch",
        "flake:scan": "@php bin/porta-dev flake:scan",
        "lsp": "@php bin/keep-going lsp:steps",
        "lsp:steps": [
            "@lsp:analyze",
            "@lsp:probe"
        ],
        "lsp:analyze": "s=0; for d in src tests plugins; do phpantom_lsp analyze --no-colour $d || s=1; done; exit $s",
        "lsp:probe": "@php bin/porta-dev lsp:probe",
        "duplication": "@php vendor/bin/phpcpd --exclude vendor src plugins tests bin config",
        "container": "@php bin/porta-dev container",
        "build:phar": "@php bin/build-phar",
        "verify:quick": [
            "@format:check",
            "@lint",
            "@analyze",
            "@rector:check",
            "@arch",
            "@duplication"
        ],
        "verify": [
            "@verify:quick",
            "@coverage:check"
        ],
        "mutate:clean": "rm -rf coverage/infection coverage/infection_* coverage/infection-* coverage/infection.log",
        "mutate": [
            "@php -d pcov.enabled=1 -d pcov.directory=src vendor/bin/paratest --processes=${PORTA_TEST_PROCESSES:-$(( ($(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4) + 1) / 2 ))} --testsuite=Unit --passthru-php=\"'-d' 'pcov.enabled=1' '-d' 'pcov.directory=src'\" --coverage-xml=coverage/infection/coverage-xml --log-junit=coverage/infection/junit.xml",
            "@php vendor/bin/infection --coverage=coverage/infection --skip-initial-tests --git-diff-lines --git-diff-base=HEAD --threads=${PORTA_MUTATE_THREADS:-$(( ($(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4) + 1) / 2 ))} --test-framework-options='--testsuite=Unit --colors=never' --show-mutations"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true
        },
        "process-timeout": 0,
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
            "php": "8.5.0"
        }
    }
}
