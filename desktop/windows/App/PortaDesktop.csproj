<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Two builds of the window: x64, and Arm64 natively (.NET Framework 4.8.1 is the first on Arm). -->
    <TargetFrameworks>net48;net481</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <!-- For the font dialog alone: WPF has none. -->
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>Porta</AssemblyName>
    <RootNamespace>Porta.Desktop.App</RootNamespace>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
    <StartupObject>Porta.Desktop.App.Program</StartupObject>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net481'">
    <PlatformTarget>ARM64</PlatformTarget>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CI.Microsoft.Terminal.Wpf" Version="1.22.250204002" />
    <ProjectReference Include="..\Core\PortaDesktop.Core.csproj" />
  </ItemGroup>
</Project>
