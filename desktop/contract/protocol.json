{
    "environment": {
        "flag": "PORTA_DESKTOP",
        "token": "PORTA_DESKTOP_TOKEN"
    },
    "osc": 7777,
    "namespace": "porta-desktop",
    "hostToPorta": ["close"],
    "portaToHost": ["ready", "accepted", "closing"],
    "examples": {
        "token": "0123456789abcdef0123456789abcdef",
        "close": "\u001b]7777;porta-desktop;0123456789abcdef0123456789abcdef;close\u001b\\",
        "ready": "\u001b]7777;porta-desktop;0123456789abcdef0123456789abcdef;ready\u001b\\",
        "accepted": "\u001b]7777;porta-desktop;0123456789abcdef0123456789abcdef;accepted\u001b\\",
        "closing": "\u001b]7777;porta-desktop;0123456789abcdef0123456789abcdef;closing\u001b\\"
    }
}
