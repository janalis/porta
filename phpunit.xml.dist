<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         failOnDeprecation="true"
         failOnPhpunitDeprecation="true"
         failOnNotice="true"
         failOnEmptyTestSuite="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
>
    <php>
        <!-- Keep tests away from the developer's real ~/.porta/plugins, while
             installing the bundled `tempest` highlighter as a *global* plugin so
             every booted Ide is coloured. Global plugins are opt-out, so this
             needs no per-project config file (which would perturb the git and
             file-tree fixtures). -->
        <env name="PORTA_HOME" value="./tests/Support/fixtures/home" force="true"/>
        <!-- The bundled plugins load only in scenarios that opt in via putenv. -->
        <env name="PORTA_EMBEDDED_PLUGINS" value="/nonexistent" force="true"/>
    </php>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <testsuite name="E2e">
            <directory>tests/E2e</directory>
        </testsuite>
        <!-- A plugin owns its tests the way it owns its code. -->
        <testsuite name="Plugins">
            <directory>plugins/*/tests</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>src</directory>
            <!-- plugins/*/src is deliberately NOT here, though plugin code is
                 gated at 100% like everything else: it is graded by its own
                 SERIAL pass (`composer coverage:plugins`, which adds the
                 directory through phpunit's own coverage-filter flag). It
                 cannot be graded in this parallel run, and the reason is
                 upstream: each worker
                 serializes its coverage with every path made relative to that
                 worker's own longest common directory (php-code-coverage's
                 PathReducer), while the merge keeps only the FIRST worker's
                 base path (Serialization/Merger). A worker that covered a
                 plugin file reduces to the repo root instead of `src`, so on
                 merge every one of its paths resolves wrong, fails the filter,
                 and that entire worker's data is dropped — silently, and
                 differently each run (measured: totals of 86%–95%, spread over
                 every file, from one or two lost workers). Nothing in this
                 project's configuration can prevent it; a serial run has no
                 merge at all. -->
        </include>
    </source>

    <!-- Never fall back to static analysis for files a worker did not load:
         its executable-line map disagrees with pcov's on match expressions
         (the `return match` line), and one static-mapped worker poisons the
         paratest merge with phantom uncovered lines. Every src file is still
         compiled under pcov by the container-building tests in some worker
         (PORTA_CONTAINER_CACHE=off in tests/bootstrap.php), so no file can
         drop out of the report. -->
    <coverage includeUncoveredFiles="false"/>
    <extensions>
        <bootstrap class="Porta\Tests\Support\LoopIsolationExtension"/>
        <bootstrap class="Porta\Tests\Support\EnvIsolationExtension"/>
    </extensions>
</phpunit>
