<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         displayDetailsOnTestsThatTriggerWarnings="true"
         displayDetailsOnTestsThatTriggerNotices="true"
>
    <php>
        <!-- Keep tests away from the developer's real ~/.porta/plugins, while
             installing the bundled `tempest` highlighter as a *global* plugin so
             every booted Ide is coloured. Global plugins are opt-out, so this
             needs no per-project config file (which would perturb the git and
             file-tree fixtures). -->
        <env name="PORTA_HOME" value="./tests/Support/fixtures/home" force="true"/>
        <!-- The bundled plugins load only in scenarios that opt in via putenv. -->
        <env name="PORTA_EMBEDDED_PLUGINS" value="/nonexistent" force="true"/>
    </php>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
        <testsuite name="E2e">
            <directory>tests/E2e</directory>
        </testsuite>
        <!-- A plugin owns its tests the way it owns its code. -->
        <testsuite name="Plugins">
            <directory>plugins/*/tests</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>src</directory>
            <!-- Code a plugin ships is code this project ships: the 100% gate
                 follows it into plugins/, or moving a class there would be a way
                 to launder it past the gate. `composer coverage` widens pcov's
                 own instrumentation window to match (pcov.directory) — without
                 that, this include admits files the driver never measured. -->
            <directory>plugins/*/src</directory>
        </include>
    </source>

    <!-- Never fall back to static analysis for files a worker did not load:
         its executable-line map disagrees with pcov's on match expressions
         (the `return match` line), and one static-mapped worker poisons the
         paratest merge with phantom uncovered lines. Every src file is still
         compiled under pcov by the container-building tests in some worker
         (PORTA_CONTAINER_CACHE=off in tests/bootstrap.php), so no file can
         drop out of the report. -->
    <coverage includeUncoveredFiles="false"/>
    <extensions>
        <bootstrap class="Porta\Tests\Support\LoopIsolationExtension"/>
    </extensions>
</phpunit>
