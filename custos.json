{
  "php": "8.5",
  "comparisonStyle": "yoda",
  "paths": [
    "src",
    "plugins",
    "tests",
    "bin",
    "config"
  ],
  "rules": {
    "ElvisOperatorCanBeUsed": {
      "enabled": false
    },
    "ClassConstantCanBeUsed": {
      "enabled": false
    },
    "UnnecessaryCasting": {
      "enabled": false
    },
    "ClassMethodNameMatchesFieldName": {
      "enabled": false
    },
    "NullPointerException": {
      "enabled": true
    },
    "DisconnectedForeachInstruction": {
      "enabled": true
    },
    "ClassOverridesFieldOfSuperClass": {
      "enabled": true
    },
    "ComparisonOperandsOrder": {
      "enabled": true
    },
    "UnqualifiedReference": {
      "enabled": true
    },
    "UnNecessaryDoubleQuotes": {
      "enabled": true
    },
    "MultipleReturnStatements": {
      "enabled": true
    }
  }
}
