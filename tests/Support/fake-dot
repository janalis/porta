#!/usr/bin/env php
<?php

// A dot stand-in for tests: drains stdin (the DOT document), ignores it, and
// emits the committed small-graph -Tjson0 fixture — so every DotLayoutEngine
// branch is coverable without graphviz installed. Also serves the export
// shape: with `-o <path>` it writes a marker file instead of printing.

declare(strict_types=1);

$stdin = (string) stream_get_contents(STDIN);
if (str_contains($stdin, 'broken')) {
    // The invalid-document contract: a DOT containing the 'broken' sentinel
    // fails the way real dot does — parse error on stderr, non-zero exit.
    fwrite(STDERR, "syntax error near 'broken'\n");

    exit(1);
}

$args = array_slice($argv, 1);
$outIndex = array_search('-o', $args, true);
if (false !== $outIndex && isset($args[$outIndex + 1])) {
    file_put_contents($args[$outIndex + 1], 'fake export: '.implode(' ', $args)."\n");

    exit(0);
}

echo file_get_contents(__DIR__.'/fixtures/graph/small.json');
