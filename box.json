{
    "$schema": "https://raw.githubusercontent.com/box-project/box/main/res/schema.json",
    "directories": [
        "src",
        "config",
        "translations"
    ],
    "finder": [
        {
            "in": "docs",
            "exclude": [
                "public"
            ]
        },
        {
            "in": "plugins",
            "exclude": [
                ".github",
                "tests",
                "vendor"
            ]
        },
        {
            "in": "vendor"
        }
    ],
    "files": [
        "composer.json"
    ]
}
