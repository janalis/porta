  key falls back to this English source.
-->
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
  <file source-language="en" target-language="en" datatype="plaintext" original="messages">
    <body>
    </body>
  </file>
</xliff>
