#!/usr/bin/env php
<?php

declare(strict_types=1);

// Before anything namespaced loads: under an older PHP the first src/ file
// would die with a parse error instead of a sentence.
if (\PHP_VERSION_ID < 80500) {
    fwrite(STDERR, 'porta: PHP >= 8.5 is required, this is PHP '.\PHP_VERSION.".\n");
    exit(1);
}

// Locate the Composer autoloader whether we run from this package's checkout
// or as an installed dependency (vendor/<name>/porta/bin/porta).
$autoloadCandidates = [
    __DIR__.'/../vendor/autoload.php',
    __DIR__.'/../../../autoload.php',
    __DIR__.'/../../../../autoload.php',
];

$autoloaded = false;
foreach ($autoloadCandidates as $candidate) {
    if (is_file($candidate)) {
        require $candidate;
        $autoloaded = true;
        break;
    }
}

if (!$autoloaded) {
    fwrite(STDERR, "porta: could not find Composer's autoload.php. Run 'composer install' first.\n");
    exit(1);
}

// The binary git is told to run by --git-setup is Install\PortaBinary's: the
// phar when this is one, else the package's own bin/porta.
// The phar build stamps its version over this placeholder (bin/build-phar); a
// checkout or a composer install keeps the package constant.
$built = '@package_version@';
$version = str_starts_with($built, '@') ? Porta\Ide::VERSION : $built;
// `porta <name> …` where a bundled plugin ships a command of that name —
// `porta review …` is the review plugin's — runs it instead of opening a path.
$pluginCommand = Porta\Console\PluginCommands::bundled()->find($argv[1] ?? '');
if (null !== $pluginCommand) {
    $application = new Symfony\Component\Console\Application('porta', Porta\Ide::VERSION);
    $application->addCommand($pluginCommand);
    $application->setDefaultCommand((string) $pluginCommand->getName(), true);
    $application->run(new Symfony\Component\Console\Input\ArgvInput([$argv[0], ...array_slice($argv, 2)]));

    return;
}
$entry = Porta\Install\PortaBinary::entry((string) ($_SERVER['SCRIPT_FILENAME'] ?? ''), Porta\Install\PortaBinary::path());
$command = new Porta\Console\PortaCommand(self: Porta\Install\PortaBinary::path(), version: $version, phar: '' === Porta\Install\PortaBinary::phar() ? '' : $entry, env: getenv());
$application = new Symfony\Component\Console\Application('porta', $version);
$application->addCommand($command);
$application->setDefaultCommand((string) $command->getName(), true); // single-command app
$application->run();
